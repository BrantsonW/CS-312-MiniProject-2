<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Joke Generator</title>

    <link rel="stylesheet" href="/styles.css">
</head>

<body>

    <main>
        <header>
        <h1>Joke Generator</h1>
        </header>

        <section>

        <p>Choose a category and get a joke</p>

        <form action="/joke" method="POST">

            <label for="category">Joke Category:</label>

            <select id="category" name="category">

                <option value="Any">Any</option>

                <option value="Programming">Programming</option>

                <option value="Misc">Misc</option>

                <option value="Pun">Dark</option>

                <option value="Pun">Pun</option>

                <option value="Spooky">Spooky</option>

                <option value="Christmas">Christmas</option>

            </select>

            <button type="submit">MAKE ME LAUGH</button>

        </form>
        </section>

        <section>
        <% if (joke) { %>
            <div class="joke">
                <% if (joke.type == "single") { %>
                    <p><%= joke.joke %></p>

                <% } else { %>
                    <p><%= joke.setup %></p>
                    <p><strong><%= joke.delivery %></strong></p>
                <% } %>
            </div>
        <% } %>

        <% if (error) { %>
            <div class="error">
                <p><%= error %></p>
                <p>Please choose a category and try again.</p>
            </div>
        <% } %>

        </section>

        <section>
            <h>DISCLAIMER: These jokes have no filter, some jokes displayed may cross a line</h>
        </section>
    </main>

</body>

</html>